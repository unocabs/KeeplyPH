# Copy to .env.local. Never commit real keys. Leave blank until accounts exist.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Alternatively, local Supabase/legacy projects can use SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000
APP_ENV=development
# Complete before public launch. These appear in the privacy/terms pages.
OPERATOR_NAME=
SUPPORT_EMAIL=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=Keeply <reminders@keeplyph.com>
EMAIL_DELIVERY_ENABLED=false
# SMS launch is postponed. The code-level launch gate also prevents activation.
# Keep disabled until a future launch, sender approval and a controlled delivery test.
SMS_DELIVERY_ENABLED=false
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
# Generate a separate random 32-byte secret; keep stable while verification codes are active.
SMS_VERIFICATION_SECRET=
# Standards-based Web Push; enable after migration 014 and a controlled device test.
PUSH_DELIVERY_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A monitored contact, e.g. mailto:support@your-domain.com
VAPID_SUBJECT=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Dedicated test/live databases must also match private.billing_settings.live.
# Standard hosted checkout only; customers renew manually. Processing fees still apply.
PAYMONGO_MODE=test
PAYMONGO_PAYMENT_METHODS=gcash,card,qrph
PAYMENTS_ENABLED=false
# Generate a random 32-byte secret for scheduled job requests.
CRON_SECRET=

# Optional anonymous daily public-page counters (no cookies, IPs or referrer URLs).
ANALYTICS_ENABLED=false
